<?xml version="1.0" encoding="utf-8"?>
<Autodiscover xmlns="http://microsoft.com">
  <Response xmlns="http://microsoft.com">
    <Account>
      <AccountType>email</AccountType>
      <Action>settings</Action>
      <Protocol>
        <Type>IMAP</Type>
        <Server>imap.gmail.com</Server>
        <Port>993</Port>
        <SSL>on</SSL>
        <AuthRequired>on</AuthRequired>
        <SPA>off</SPA>
      </Protocol>
      <Protocol>
        <Type>SMTP</Type>
        <Server>smtp.gmail.com</Server>
        <Port>465</Port>
        <SSL>on</SSL>
        <AuthRequired>on</AuthRequired>
        <SPA>off</SPA>
      </Protocol>
    </Account>
  </Response>
</Autodiscover>
